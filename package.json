  "keywords": ["axi", "done", "proof", "evidence", "screenshot", "verification", "cli", "agent", "ai-agents", "coding-agents"],
  "bin": { "done-done-axi": "dist/cli.js", "done-done": "dist/cli.js" },
  "files": ["dist", "!dist/skill.js", "skills", "docs", "integrations"],
  "engines": { "node": ">=22.18" },
  "scripts": {
    "build:skill": "tsc && node dist/skill.js",
