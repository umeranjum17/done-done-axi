  "license": "Apache-2.0",
  "description": "Prove your app really works: done-done drives your app the way a user does, a fresh judge checks every capture, and the proof is tied to a commit.",
  "type": "module",
  "repository": { "type": "git", "url": "git+https://github.com/umeranjum17/done-done-axi.git" },
